{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run WTP Component Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/client-vscode",
                "--user-data-dir=${workspaceFolder}/client-vscode/.vscode-test-userdata"
            ],
            "outFiles": [
                "${workspaceFolder}/client-vscode/out/**/*.js"
            ],
            // "preLaunchTask": "npm: build",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}