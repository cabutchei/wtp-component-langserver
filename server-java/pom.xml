  <groupId>com.github.cabutchei.wtpcomponent</groupId>
  <artifactId>wtp-component-ls</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
