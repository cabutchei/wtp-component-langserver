      <systemPath>${project.basedir}/lib/org.eclipse.equinox.common_3.20.0.v20250129-1348.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.equinox.app</artifactId>
      <version>1.7.300.v20250130-0528</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.equinox.app_1.7.300.v20250130-0528.jar</systemPath>
    </dependency>

    <!-- EMF + Web Tools Platform internals -->
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.common</artifactId>
      <version>2.12.0.v20160420-0247</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.emf.common_2.12.0.v20160420-0247.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.webtools.common</groupId>
      <artifactId>org.eclipse.wst.common.core</artifactId>
      <version>1.2.0.v200908251833</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.wst.common.core_1.2.0.v200908251833.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.webtools.common</groupId>
      <artifactId>org.eclipse.wst.common.modulecore</artifactId>
      <version>1.2.401.v201408132036</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.wst.common.modulecore_1.2.401.v201408132036.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.webtools.common</groupId>
      <artifactId>org.eclipse.wst.common.emf</artifactId>
      <version>1.2.800.v202503020719</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.wst.common.emf_1.2.800.v202503020719.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.webtools.common</groupId>
      <artifactId>org.eclipse.wst.xml.core</artifactId>
      <version>1.2.900.v202405130132</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.wst.xml.core_1.2.900.v202405130132.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.webtools.javaee</groupId>
      <artifactId>org.eclipse.jst.j2ee</artifactId>
      <version>1.1.850.v201506041749</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.jst.j2ee_1.1.850.v201506041749.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.webtools.javaee</groupId>
      <artifactId>org.eclipse.jst.j2ee.core</artifactId>
      <version>1.3.200.v201505041449</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.jst.j2ee.core_1.3.200.v201505041449.jar</systemPath>
    </dependency>

    <!-- Additional runtime pieces resolved from Maven Central -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.core</artifactId>
      <version>6.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore</artifactId>
      <version>2.12.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
      <version>2.12.0</version>
    </dependency>

    <dependency>
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j</artifactId>
      <version>0.22.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j.jsonrpc</artifactId>
      <version>0.22.0</version>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.17.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
        <!-- Strip signatures from shaded deps -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <exclude>META-INF/INDEX.LIST</exclude>
                    <exclude>META-INF/*SIG*</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.github.cabutchei.wtpcomponent.lsp.ServerMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
